# Rendered by the official nginx image entrypoint (envsubst) from:
#   SEARCH_INDEXING  false (default) | deindex | true
#   API_UPSTREAM     host:port of the API container
#
# false   : robots.txt "Disallow: /" for every crawler + X-Robots-Tag noindex + <meta robots noindex>
# deindex : crawlable robots.txt but noindex everywhere (use temporarily to remove an
#           already-indexed domain: search engines must be able to fetch pages to see noindex)
# true    : normal indexing

map "${SEARCH_INDEXING}" $robots_header {
    "true"   "";
    default  "noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate";
}
map "${SEARCH_INDEXING}" $robots_file {
    "true"     "/robots-allow.txt";
    "deindex"  "/robots-allow.txt";
    default    "/robots-disallow.txt";
}
map "${SEARCH_INDEXING}" $robots_meta {
    "true"   "";
    default  '<meta name="robots" content="noindex, nofollow, noarchive" />';
}
map "${SEARCH_INDEXING}" $googlebot_meta {
    "true"   "";
    default  '<meta name="googlebot" content="noindex, nofollow" />';
}
map $http_upgrade $connection_upgrade { default upgrade; "" ""; }

# Docker's DNS. The API container gets a new address whenever it is recreated (every update): look it
# up again every 10 s instead of once at start, which left this proxy answering 502 after an update.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream api_backend {
    zone api_backend 64k;
    server ${API_UPSTREAM} resolve;
    keepalive 16;
}

server {
    listen 8080 default_server;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 64k;

    # Real client IP: trust X-Forwarded-For only when it comes from a private-network proxy
    # (Caddy / your load balancer); everything else uses the TCP peer address.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    absolute_redirect off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain text/csv;
    gzip_min_length 1024;

    # every response (static, API, errors) carries the robots policy and security headers
    add_header X-Robots-Tag $robots_header always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location = /robots.txt {
        default_type text/plain;
        add_header X-Robots-Tag $robots_header always;
        add_header Cache-Control "no-cache" always;
        try_files $robots_file =404;
    }

    # Server-Sent Events: no buffering, long-lived
    location = /api/stream {
        proxy_pass http://api_backend;
        proxy_hide_header X-Robots-Tag;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        add_header X-Robots-Tag $robots_header always;
        add_header Cache-Control "no-cache" always;
    }

    location /api/ {
        proxy_pass http://api_backend;
        proxy_hide_header X-Robots-Tag;  # nginx sets the single, policy-driven header
        proxy_http_version 1.1;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # hashed build assets: cache for a year
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Robots-Tag $robots_header always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA: every route serves index.html (robots meta swapped according to SEARCH_INDEXING)
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Robots-Tag $robots_header always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        sub_filter_once on;
        sub_filter_types text/html;
        sub_filter '<meta name="robots" content="noindex, nofollow, noarchive" />' $robots_meta;
        sub_filter '<meta name="googlebot" content="noindex, nofollow" />' $googlebot_meta;
    }
}
