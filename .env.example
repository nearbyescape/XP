# ============================================================================================
# SignalDesk configuration. Copy to .env and fill in every value marked REQUIRED.
# ============================================================================================

# --- product ---------------------------------------------------------------------------------
APP_NAME=SignalDesk
# Public URL of the dashboard (used for "Open signal" buttons in Telegram)
PUBLIC_BASE_URL=https://signals.example.com
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- database (REQUIRED: POSTGRES_PASSWORD) ------------------------------------------------------
POSTGRES_USER=signals
POSTGRES_PASSWORD=
POSTGRES_DB=signals
# Daily pg_dump into ./backups by the `backup` service; copy them off the server regularly
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24

# --- security (REQUIRED) -----------------------------------------------------------------------
# Generate with:  openssl rand -hex 32
SECRET_KEY=
ADMIN_USERNAME=admin
# Admin console at /admin (leave empty to disable the console)
ADMIN_PASSWORD=
# Keep true behind HTTPS; set false only for plain-HTTP local testing
COOKIE_SECURE=true
SESSION_HOURS=12

# --- search engines ----------------------------------------------------------------------------
# false (default): robots.txt Disallow + X-Robots-Tag noindex + <meta robots noindex>
# deindex: crawlable but noindex (temporarily, to remove an already-indexed domain)
# true: allow indexing
SEARCH_INDEXING=false
# true (default): the whole website is private. Visitors see only a sign-in screen (admin login +
# security question); every page, the API and the live stream need it. Telegram posts then carry no
# website link and the pinned rules explain sizing without the calculator. false: open dashboard.
SITE_PRIVATE=true

# --- web / TLS -----------------------------------------------------------------------------------
WEB_PORT=8080
# 0.0.0.0 to expose directly; 127.0.0.1 when Caddy or your own reverse proxy terminates TLS
WEB_BIND=0.0.0.0
# For `docker compose --profile tls up -d`: domain pointing at this server + Let's Encrypt e-mail
DOMAIN=
ACME_EMAIL=
# API worker processes. One serves a few hundred concurrent visitors; raise to 2-4 (one per CPU core)
# if /api latency grows. Admin login rate limiting is then counted per worker.
# WEB_CONCURRENCY=1

# --- market data ---------------------------------------------------------------------------------
# binance_futures (default: subscribers trade USDT-M perpetuals) | binance_spot | replay
# The strategies were validated on spot candles, which the perpetuals track within a few basis points.
# Use binance_spot if the server's region cannot reach fapi.binance.com.
MARKET_DATA_SOURCE=binance_futures
BINANCE_SPOT_URLS=https://data-api.binance.vision,https://api.binance.com,https://api1.binance.com
BINANCE_FUTURES_URLS=https://fapi.binance.com
# Strategies A/B work on any USDT pair; strategy C (ML) only on the 10 coins it was trained on
UNIVERSE=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,DOTUSDT
# History downloaded on first start (indicators need years of 4h candles for exact parity)
BACKFILL_FROM=2017-08-01T00:00:00Z

# --- publishing session ----------------------------------------------------------------------------
# Signals whose 4H candle closes inside the session are published (09:30, 13:30, 17:30, 21:30 IST);
# the others are tracked unpublished. Target / stop updates outside the session arrive without sound
# (OVERNIGHT_UPDATES=silent) and are recapped in the morning greeting.
SESSION_TZ=Asia/Kolkata
SESSION_START=09:00
SESSION_END=23:00
ENTRY_WINDOW_MINUTES=15
OVERNIGHT_UPDATES=silent

# --- strategies ----------------------------------------------------------------------------------
# Initial modes (live | shadow | off). After the first start the admin console is the source of truth.
STRATEGY_MODES=RGP-4H=live,RSR-4H=live,MLR-4H=live
DEFAULT_RISK_PCT=0.5
KILL_SWITCH_WINDOW=150
KILL_SWITCH_MIN_WIN_RATE=0.82
KILL_SWITCH_MIN_PROFIT_FACTOR=0.75

# --- risk guard (docs/deployment.md §5) -----------------------------------------------------------
# Member guidance and early warnings; none of it changes which signals publish or how they are recorded.
# Member rule: total risk across signals still before TP1 (at DEFAULT_RISK_PCT each: 10 signals)
MAX_OPEN_RISK_PCT=5.0
# A signal post notes high open risk from this many signals before TP1 (0.7% of 4H checks in 2022-26)
RISK_NOTE_SIGNALS=10
# Admin alerts (once per episode, and once when back to normal). Thresholds from 2022-26 testing:
# fall from peak of the published book, at DEFAULT_RISK_PCT per signal (worst in testing 10.2%)
WATCH_DRAWDOWN_PCT=6.0
WATCH_DRAWDOWN_CRITICAL_PCT=10.2
# a strategy's last N closed signals (worst 30-signal stretch in testing 53%)
WATCH_WIN_RATE_WINDOW=30
WATCH_WIN_RATE=0.70
WATCH_WIN_RATE_CRITICAL=0.50
# signals before TP1 in one direction (2-3 days a year in testing)
WATCH_SAME_DIRECTION=12

# --- Telegram (token from @BotFather) ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# "@yourchannel" for a public channel or the numeric id (-100…) for a private one.
# The bot must be added to the channel as an administrator with "Post messages" and "Edit messages".
TELEGRAM_CHANNEL_ID=
# Public invite link shown on the website, e.g. https://t.me/yourchannel
TELEGRAM_CHANNEL_URL=
# Channel only by default; true also delivers signals to users who /start the bot
TELEGRAM_DM_ENABLED=false
# Greeting at the session start and summary of the day at the session end
TELEGRAM_SESSION_MESSAGES=true
# "Setup forming" note (silent, at most once a day) when the AI model's best score is within this of its
# threshold at one of the day's first two checks and nothing has been published yet (docs/deployment.md §3)
TELEGRAM_WATCH_MESSAGES=true
WATCH_SCORE_MARGIN=0.005
# Ops alerts (engine errors, Binance outage/recovery, kill switch, failed deliveries) go to these
# private chats, comma-separated. Press Start on your bot and send /id to get your chat id.
# These chats can also send /status to the bot.
TELEGRAM_ADMIN_CHAT_IDS=
